# Where /api/forms delivers submissions. Both site forms — the /contact-us
# enquiry form and the footer subscribe form — go to info@humansoferp.com with
# jon@pepco.com.au cc'd, and reply-to set to whoever wrote in.
#
# Requires humansoferp.com to be a *verified* domain in the Resend account;
# until its DKIM/SPF records resolve, Resend rejects the send with a 403.
RESEND_API_KEY=

# Optional. Overrides the From address — useful on a preview deploy before the
# domain verifies (Resend's onboarding@resend.dev only delivers to the account
# owner's own address).
# FORM_FROM_EMAIL=Humans of ERP <noreply@humansoferp.com>

# Optional fallback, used only when RESEND_API_KEY is unset: post the raw
# submission to a Slack/Teams/Zapier/CRM incoming webhook instead.
# With neither set, submissions are logged to the function console.
FORM_WEBHOOK_URL=
